# AI
AI_PROVIDER=groq
AI_FALLBACK_ENABLED=true
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# AUTH
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_secret

# These are intentionally internal Docker connection strings.
# The browser does not need database access.
POSTGRES_DATABASE_URL=postgresql+psycopg://debate:debate@postgres:5432/debate_coach
MONGODB_URI=mongodb://mongodb:27017

# APPLICATION
FRONTEND_URL=http://localhost:3200
BACKEND_URL=http://localhost:8200
CORS_ORIGINS=http://localhost:3200
UPLOAD_DIRECTORY=./uploads

# SpeakAZ — Environment Variables
# Copy this to backend/.env and fill in your API keys

# ============= Required: LLM =============
GEMINI_API_KEY=your_gemini_api_key_here

# ============= Optional: Groq (faster LLM for argument analysis) =============
# GROQ_API_KEY=your_groq_api_key_here

# ============= Optional: Database =============
# Defaults to SQLite (speakaz.db) — no setup needed!
# Uncomment below ONLY if you want MySQL instead:
# MYSQL_PASSWORD=your_secure_password_here
# MYSQL_DATABASE=speakaz
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PORT=3306

# Or override the full URL directly (PostgreSQL, etc):
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost/speakaz

# ============= Optional: App Settings =============
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SECRET_KEY=change-me-in-production

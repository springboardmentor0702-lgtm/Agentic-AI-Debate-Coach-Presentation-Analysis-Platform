:root{--chart-text:#8f99aa;--chart-grid:rgba(120,140,170,.12);--chart-legend:#aeb8c9}
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
:root{font-family:'DM Sans',sans-serif;color:#e9edf7;background:#080a11;line-height:1.5;font-synthesis:none}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 80% -10%,#26365d 0,transparent 34%),#080a11}button,input,textarea,select{font:inherit}button{cursor:pointer}.app-shell{display:flex;min-height:100vh}.sidebar{width:255px;background:rgba(10,13,22,.92);border-right:1px solid #20263a;padding:18px 12px;position:sticky;top:0;height:100vh;transition:.2s}.sidebar.closed{width:78px}.brand{display:flex;align-items:center;gap:10px;padding:7px 9px 24px}.brand-mark{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,#8b7cff,#4de1c1);display:grid;place-items:center;color:#071014;font-weight:800}.brand b{font-family:'Space Grotesk';font-size:17px}.brand b span{color:#7dffe0}.brand small{display:block;color:#7d8496;font-size:10px}.nav{width:100%;border:0;background:transparent;color:#9da5b7;display:flex;gap:12px;align-items:center;padding:11px 12px;border-radius:10px;margin:2px 0;text-align:left}.nav:hover,.nav.active{background:#171d2d;color:#fff}.logout{margin-top:auto}.main{flex:1;min-width:0}.topbar{height:70px;border-bottom:1px solid #20263a;display:flex;align-items:center;padding:0 24px;gap:16px;background:rgba(8,10,17,.75);backdrop-filter:blur(14px);position:sticky;top:0;z-index:3}.crumb{font-family:'Space Grotesk';font-weight:600}.top-actions{margin-left:auto;display:flex;align-items:center;gap:14px}.demo-pill{border:1px solid #4a3e70;background:#211b38;color:#c8bbff;padding:6px 10px;border-radius:999px;font-size:11px}.demo-pill span{display:inline-block;width:6px;height:6px;background:#9d84ff;border-radius:50%;margin-right:5px}.avatar{width:34px;height:34px;border-radius:50%;background:#1d2638;display:grid;place-items:center}.content{max-width:1400px;margin:auto;padding:32px}.hero{display:flex;justify-content:space-between;align-items:end;gap:30px;padding:28px 0 34px}.hero h1,.login-card h1{font-family:'Space Grotesk';font-size:40px;line-height:1.05;margin:8px 0 12px}.hero h1 span,.login-card h1 span{color:#7dffe0}.eyebrow{font-size:11px;letter-spacing:.16em;color:#7dffe0;font-weight:700}.muted{color:#8e97aa}.primary,.secondary,.link-btn{border:0;border-radius:10px;padding:11px 16px}.primary{background:#7dffe0;color:#061012;font-weight:700}.secondary{background:#171d2d;color:#e8edf7;border:1px solid #2b344b}.full{width:100%}.link-btn{background:none;color:#7dffe0;padding:8px}.icon-btn{background:#121724;border:1px solid #273048;color:#c9d0df;border-radius:9px;padding:8px;display:grid;place-items:center}.section{margin:22px 0 34px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:16px}.section h2{font-family:'Space Grotesk';font-size:23px;margin:0}.section-head p{margin:5px 0 0}.grid{display:grid;gap:16px}.four{grid-template-columns:repeat(4,1fr)}.three{grid-template-columns:repeat(3,1fr)}.two{grid-template-columns:repeat(2,1fr)}.kpi,.card,.action-card,.studio,.debate-room,.upload-zone,.notif,.empty{background:linear-gradient(180deg,rgba(22,28,43,.92),rgba(13,17,27,.92));border:1px solid #242d43;border-radius:15px;padding:18px}.kpi span,.kpi small{display:block;color:#8791a7;font-size:12px}.kpi strong{display:block;font-family:'Space Grotesk';font-size:28px;margin:5px 0}.kpi small{color:#7dffe0}.card{min-height:180px}.card-title{margin-bottom:16px;text-transform:capitalize;color:#cfd6e4}.card canvas{max-height:320px}.action-card h3{margin:10px 0}.action-card button{background:none;border:0;color:#7dffe0;padding:0}.step{font-size:11px;color:#77839a}.form-grid{display:grid;grid-template-columns:2fr 1fr 1fr .7fr;gap:14px;margin-bottom:18px}.form-grid label{font-size:12px;color:#9ca6b9;position:relative}.form-grid textarea,.form-grid input,.form-grid select,.analysis-input textarea,.search-row input,.composer textarea,.login-card input,.login-card select{width:100%;background:#0d121d;border:1px solid #29334a;color:#edf2fb;border-radius:9px;padding:11px;margin-top:7px;outline:none}.form-grid textarea{min-height:100px}.form-grid .icon-btn{position:absolute;right:8px;bottom:8px}.debate-room{margin-top:18px}.room-head{display:flex;justify-content:space-between;color:#8d97aa}.live-dot{color:#7dffe0}.message{margin:20px 0;padding:16px;border-radius:12px}.message.ai{background:#11182a;border:1px solid #283450}.message small{color:#9d84ff;font-size:10px}.composer{display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:end}.composer textarea{min-height:90px;margin:0}.composer .icon-btn{align-self:center}.score-result{display:flex;align-items:center;gap:20px;margin-top:20px;padding-top:20px;border-top:1px solid #273048}.ring{width:130px;height:130px;position:relative}.ring canvas{width:130px!important;height:130px!important}.ring span{position:absolute;inset:0;display:grid;place-items:center;font-family:'Space Grotesk';font-size:27px;font-weight:700}.chips{display:flex;gap:10px;flex-wrap:wrap}.chips button{background:#141b2a;border:1px solid #29334a;color:#b9c1d2;padding:9px 12px;border-radius:999px}.analysis-input{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:end;margin-bottom:18px}.analysis-input textarea{min-height:150px}.analysis-input>div{display:flex;gap:8px}.analysis-output pre{white-space:pre-wrap;color:#b8c1d2}.source,.code-pill{display:inline-block;color:#9d84ff;font-size:11px;margin-top:12px}.upload-zone{text-align:center;border-style:dashed;padding:40px}.upload-zone input{display:block;margin:auto}.heatmap{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin:18px 0}.slide-tile{min-height:120px;background:#11182a;border:1px solid #2a3550;border-radius:12px;padding:14px;display:flex;flex-direction:column}.slide-tile b{font-family:'Space Grotesk';font-size:20px}.slide-tile span{color:#9ca6b9;margin-top:8px}.slide-tile em{margin-top:auto;color:#7dffe0;font-style:normal}.search-row{display:flex;gap:8px;margin-bottom:16px}.search-row input{margin:0}.notif-list{display:grid;gap:10px;margin-top:15px}.notif.unread{border-color:#4f6b76}.notif small{color:#687389}.timeline{display:grid;gap:9px;margin-top:15px}.timeline div{display:flex;gap:20px;padding:12px;border-left:2px solid #7dffe0;background:#101624}.timeline span{color:#b8c1d2}.plan-head{display:flex;justify-content:space-between;align-items:center;margin-top:28px}.login-page{min-height:100vh;display:grid;place-items:center;padding:25px;position:relative;overflow:hidden}.login-glow{position:absolute;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,#263d58,transparent 65%);filter:blur(10px);opacity:.65}.login-card{width:min(520px,100%);background:rgba(11,15,24,.9);border:1px solid #2b354e;border-radius:22px;padding:35px;position:relative;box-shadow:0 30px 100px #0008}.brand.big{padding:0 0 30px}.provider-line{font-size:11px;letter-spacing:.12em;color:#9099aa;border:1px solid #28334a;padding:9px;border-radius:9px;text-align:center;margin:18px 0}.provider-line i{color:#7dffe0;font-style:normal;padding:0 7px}.login-card form{display:grid;gap:10px}.demo-hint{font-size:10px;color:#687389;text-align:center;margin-top:20px;line-height:1.6}.error{background:#381b25;border:1px solid #6a2d3c;color:#ffb6c5;padding:9px;border-radius:8px;font-size:12px}
@media(max-width:1050px){.four{grid-template-columns:repeat(2,1fr)}.three{grid-template-columns:1fr 1fr}.form-grid{grid-template-columns:1fr 1fr}.heatmap{grid-template-columns:repeat(3,1fr)}}@media(max-width:720px){.sidebar{position:fixed;z-index:5}.sidebar.closed{width:0;padding:0;overflow:hidden}.content{padding:20px}.hero{display:block}.hero .primary{margin-top:15px}.two,.three,.four{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.analysis-input,.composer{grid-template-columns:1fr}.heatmap{grid-template-columns:1fr 1fr}.topbar{padding:0 14px}.hero h1{font-size:32px}}
.success{background:#112a28;border:1px solid #2f7166;color:#9ff9e9;padding:11px;border-radius:9px;margin:12px 0}.slide-tile{border:1px solid #2a3550;color:#e9edf7;text-align:left}
.name-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.form-note{font-size:11px;color:#78849a;margin:0}.wide-input{width:100%;min-height:130px;background:#0d121d;border:1px solid #29334a;color:#edf2fb;border-radius:9px;padding:12px;margin-top:10px}.right-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:10px}.friend-row,.owner-row{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:12px 0;border-bottom:1px solid #222b3e}.friend-row:last-child,.owner-row:last-child{border-bottom:0}.friend-row small,.owner-row small{display:block;color:#7f899c}.selected{border-color:#7dffe0}.studio>input,.studio>textarea{width:100%;background:#0d121d;border:1px solid #29334a;color:#edf2fb;border-radius:9px;padding:11px;margin:5px 0 12px}.analysis-output{white-space:pre-wrap;overflow:auto;color:#cbd3e3;font-size:12px;line-height:1.6}
@media(max-width:720px){.name-grid{grid-template-columns:1fr}.friend-row,.owner-row{align-items:flex-start;flex-direction:column}}
/* Product polish: distinct role workflows, conversational debate and actionable empty states */
.nav{flex-shrink:0}.sidebar nav{display:flex;flex-direction:column}.empty{min-height:120px}.empty p{color:#aab3c5;margin-bottom:0}.message{max-width:82%;white-space:pre-wrap}.message.user{margin-left:auto;background:#17352f;border:1px solid #285f55}.message.ai{margin-right:auto}.speak-btn{font-size:11px;padding-left:0}.typing{display:flex;align-items:center;gap:5px;color:#8994a9;font-size:12px;margin:12px 0}.typing span{width:6px;height:6px;border-radius:50%;background:#7dffe0;display:block;animation:pulse 1s infinite alternate}.typing span:nth-child(2){animation-delay:.2s}.typing span:nth-child(3){animation-delay:.4s}@keyframes pulse{to{opacity:.25;transform:translateY(-2px)}}.composer{grid-template-columns:1fr auto auto auto}.voice-toggle{white-space:nowrap}.coaching-alert{margin-top:15px;padding:12px;border:1px solid #6b5061;border-radius:10px;background:#241923}.coaching-alert b{color:#ffcfda}.coaching-alert span{color:#b8a6ae;font-size:12px}.coaching-alert.good{border-color:#2e665c;background:#112823}.coaching-alert.good b{color:#9ff9e9}.skill-list{display:grid;gap:17px}.skill-list>div>span{display:inline-block;min-width:55%}.skill-list strong{float:right}.bar{height:7px;background:#0a0f18;border:1px solid #263047;border-radius:99px;overflow:hidden;margin-top:7px}.bar i{display:block;height:100%;background:#7dffe0;border-radius:99px}.skill-list small{display:block;color:#77849a;margin-top:5px}.gap-list{display:grid;gap:10px}.gap-list>div{display:grid;grid-template-columns:1fr auto;gap:4px;padding:11px;border:1px solid #29334a;border-radius:10px;background:#101624}.gap-list small{grid-column:1/-1;color:#8e97aa}.friend-picker{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.friend-picker button{background:#121a29;border:1px solid #2a3550;color:#cbd3e1;border-radius:9px;padding:9px 12px}.friend-picker button.selected{border-color:#7dffe0;color:#fff}.status-chip{display:inline-block;padding:4px 8px;border-radius:999px;border:1px solid #3a4762;background:#121a29;color:#aeb8ca;font-size:10px;margin-right:8px}.mini-panel{margin-top:12px;padding-top:12px;border-top:1px solid #29334a}.report-toolbar{display:flex;gap:10px;justify-content:flex-end;margin-bottom:18px}.report-toolbar select{background:#0d121d;border:1px solid #29334a;color:#edf2fb;border-radius:9px;padding:10px}.notification-summary{display:inline-flex;gap:8px;align-items:center;background:#112a28;border:1px solid #2f7166;color:#9ff9e9;border-radius:999px;padding:7px 11px;margin-bottom:12px;font-size:12px}.notif>div{display:flex;align-items:center;gap:4px}.notif{padding:15px;background:#111725;border:1px solid #252f45;border-radius:12px}.notif.unread{border-color:#547d77}.notif p{margin:8px 0;color:#c3cbda}.ranking-list{display:grid;gap:0}.ranking-list>div{display:flex;justify-content:space-between;align-items:center;padding:15px 4px;border-bottom:1px solid #273048}.ranking-list>div:last-child{border-bottom:0}.ranking-list small{display:block;color:#77849a;margin-left:25px;margin-top:3px}.ranking-list strong{font-family:'Space Grotesk';font-size:18px;color:#7dffe0}.coach-answer{font-size:16px;line-height:1.7;color:#eef3fb}.card-title{display:flex;justify-content:space-between;align-items:center}.studio label{display:block;color:#9ca6b9;font-size:12px;margin-bottom:12px}.studio label input,.studio label textarea{display:block;width:100%;background:#0d121d;border:1px solid #29334a;color:#edf2fb;border-radius:9px;padding:11px;margin-top:7px}.studio label textarea{min-height:90px}.voice-btn{min-width:42px;min-height:42px}.analysis-output{background:#0a0f18;border:1px solid #202a3e;border-radius:10px;padding:14px}.top-actions .avatar{font-weight:700}.hero .primary{white-space:nowrap}@media(max-width:900px){.composer{grid-template-columns:1fr auto}.voice-toggle{grid-column:1}.composer .primary{grid-column:1/-1}.report-toolbar{justify-content:flex-start;flex-wrap:wrap}.message{max-width:96%}}

.voice-status{margin:10px 0;color:#9aa5ba;font-size:12px}.voice-test{white-space:nowrap}
.notice{margin:12px 0;padding:12px 14px;border:1px solid #2f665f;background:#10221f;color:#a9eee2;border-radius:10px;font-size:13px}.slide-source{padding:12px;border:1px solid #28334a;border-radius:10px;background:#0d121d;white-space:pre-wrap}.success{color:#9ff9e9}.error{margin-top:12px}.right-actions{flex-wrap:wrap}
.dashboard-hero{padding-bottom:22px}.dashboard-hero h1{font-size:48px}.format-rules{margin:16px 0;padding:14px;border:1px solid #2b3b55;border-radius:12px;background:linear-gradient(135deg,#101a2b,#12152a)}.format-rules b{display:block;color:#7dffe0;margin-bottom:9px}.format-rules span{display:inline-block;margin:5px 8px 5px 0;padding:6px 9px;border:1px solid #30405b;border-radius:999px;color:#c5cede;font-size:11px}.format-rules.compact{font-size:12px;color:#aeb8c9}.analysis-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.analysis-grid>.card:last-of-type{grid-column:1/-1}.score-detail{flex:1}.score-line{margin:9px 0}.score-line span{display:inline-block;width:62%;font-size:12px;color:#aab4c6}.score-line b{float:right;font-size:12px}.score-line .bar{clear:both}.fallacy-item{padding:13px 0;border-bottom:1px solid #273048}.fallacy-item:last-child{border-bottom:0}.five{grid-template-columns:repeat(5,1fr)}.notice{padding:12px 14px;border:1px solid #2d665d;background:#112521;border-radius:10px;color:#b9f6ea;margin-bottom:15px}@media(max-width:1000px){.analysis-grid,.five{grid-template-columns:1fr 1fr}.dashboard-hero h1{font-size:38px}}@media(max-width:700px){.analysis-grid,.five{grid-template-columns:1fr}.hero{align-items:flex-start;flex-direction:column}}
.voice-meter-wrap{display:flex;align-items:center;gap:9px;margin:12px 0;color:#8f99aa;font-size:11px}.voice-meter{width:150px;height:9px;border:1px solid #2b3b55;border-radius:99px;background:#0a0f18;overflow:hidden}.voice-meter span{display:block;height:100%;width:calc(var(--level) * 100%);background:#7dffe0;border-radius:99px;transition:width .08s linear}
/* Learner intelligence visual polish */
.card canvas{min-height:320px}.chart-empty{min-height:300px;display:grid;place-items:center;text-align:center;padding:30px;color:#8793a8;border:1px dashed #2b3850;border-radius:12px;background:#0d1320}.arena-status{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0 14px}.winner-banner{display:grid;gap:7px;padding:16px;border:1px solid #2f7166;background:#102521;border-radius:12px;margin-bottom:16px}.winner-banner b{font-family:'Space Grotesk';font-size:20px;color:#9ff9e9}.winner-banner span{color:#c3cbd9;line-height:1.6}.performance-card{border:1px solid #2b3550;border-radius:14px;padding:18px;background:#0e1523}.big-score{font:700 32px 'Space Grotesk';margin:8px 0 16px}.danger-action{border-color:#68404c;color:#ffc0cd}.report-preview{display:grid;gap:16px}.report-section{padding:16px;border:1px solid #29344b;border-radius:12px;background:#0d1320}.report-section h3{margin:0 0 12px}.report-item{display:grid;grid-template-columns:minmax(160px,.45fr) 1fr;gap:14px;padding:9px 0;border-bottom:1px solid #202a3d}.report-item:last-child{border-bottom:0}.report-item span{color:#b8c2d3;white-space:pre-wrap}.report-intro{color:#8f9aaf}.toggle-row{display:flex!important;align-items:center;gap:10px}.toggle-row input{width:auto!important;margin:0!important}
@media(max-width:700px){.report-item{grid-template-columns:1fr}.card canvas{min-height:250px}}

html[data-theme="light"]{color:#172033;background:#f4f7fb}
html[data-theme="light"] body{background:radial-gradient(circle at 80% -10%,#dce8ff 0,transparent 34%),#f4f7fb}
html[data-theme="light"] .sidebar{background:rgba(255,255,255,.94);border-right-color:#d9dfeb}
html[data-theme="light"] .topbar{background:rgba(255,255,255,.84);border-bottom-color:#d9dfeb}
html[data-theme="light"] .nav{color:#5b6475}
html[data-theme="light"] .nav:hover,html[data-theme="light"] .nav.active{background:#e9eef7;color:#172033}
html[data-theme="light"] .card,html[data-theme="light"] .kpi,html[data-theme="light"] .action-card{background:#fff;border-color:#d9dfeb;box-shadow:0 8px 24px rgba(35,52,80,.06)}
html[data-theme="light"] input,html[data-theme="light"] textarea,html[data-theme="light"] select{background:#fff;color:#172033;border-color:#cbd4e3}
html[data-theme="light"] .muted{color:#647086}
html[data-theme="light"] .demo-pill{background:#eef0ff;color:#5146a5;border-color:#c9c8f5}

/* Showcase polish: live arena, acoustic evidence and complete light theme. */
.live-message{margin:12px 0;padding:15px 17px;border-radius:14px;max-width:86%;box-shadow:0 8px 24px rgba(0,0,0,.12)}
.live-you{margin-left:auto;background:linear-gradient(180deg,#132d2d,#102322);border:1px solid #2d5f5a}
.live-opponent{margin-right:auto;background:linear-gradient(180deg,#171d2d,#121827);border:1px solid #2a3852}
.live-message-head{display:flex;justify-content:space-between;gap:14px;margin-bottom:6px}.live-message-head span{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:#9d84ff}.live-message p{margin:0;color:#e9edf7}.turn-you{border-color:#55cbb9!important}.turn-other{border-color:#4b5670!important}
.audio-evidence{margin-top:12px;padding:12px;border-radius:10px;background:rgba(125,255,224,.05);border:1px solid rgba(125,255,224,.18)}.audio-evidence small{display:block;color:#8e97aa;margin:3px 0 7px}.audio-evidence p{font-size:12px;color:#b9c1d2;margin:0;line-height:1.6}
html[data-theme="light"] body{color:#172033}
html[data-theme="light"] .kpi,html[data-theme="light"] .card,html[data-theme="light"] .action-card,html[data-theme="light"] .studio,html[data-theme="light"] .debate-room,html[data-theme="light"] .upload-zone,html[data-theme="light"] .empty,html[data-theme="light"] .notif{background:#fff;border-color:#d9dfeb;box-shadow:0 8px 24px rgba(35,52,80,.06)}
html[data-theme="light"] .debate-room,html[data-theme="light"] .live-opponent{background:#f7f9fc;border-color:#d9dfeb}.light html[data-theme="light"] .live-you,html[data-theme="light"] .live-you{background:#eefaf7;border-color:#b9e5dc}.light html[data-theme="light"] .live-you p,html[data-theme="light"] .live-you{color:#172033}
html[data-theme="light"] .message.ai{background:#f1f5fb;border-color:#d5deec}.message.user{background:#edf9f6;border:1px solid #c7e7df}
html[data-theme="light"] .timeline div{background:#f8fafd}.timeline div small{color:#647086}
html[data-theme="light"] .room-head,html[data-theme="light"] .live-message p{color:#27334a}
html[data-theme="light"] .format-rules,html[data-theme="light"] .notice,html[data-theme="light"] .audio-evidence{background:#f5f8fc;color:#27334a;border-color:#d8e0eb}
html[data-theme="light"] .audio-evidence p{color:#4e5d73}
html[data-theme="light"] .login-card{background:rgba(255,255,255,.96);border-color:#d9dfeb;box-shadow:0 30px 100px rgba(31,48,77,.16)}
html[data-theme="light"] .login-page .muted{color:#647086}
html[data-theme="light"]{--chart-text:#647086;--chart-grid:rgba(80,100,130,.16);--chart-legend:#4d5a70}
.trajectory-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.trajectory{padding:14px;border:1px solid #29344a;border-radius:12px;background:rgba(255,255,255,.02)}.trajectory>div{display:flex;justify-content:space-between;gap:10px}.trajectory span,.trajectory small{display:block;color:#7f8ba1;font-size:11px}.trajectory strong{display:block;font-family:'Space Grotesk';font-size:18px;margin:9px 0 2px}.trajectory em{display:block;color:#7dffe0;font-style:normal;font-weight:700}.trajectory small{margin-top:5px}html[data-theme="light"] .trajectory{background:#f8fafd;border-color:#d9dfeb}
@media(max-width:1000px){.trajectory-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.trajectory-grid{grid-template-columns:1fr}}

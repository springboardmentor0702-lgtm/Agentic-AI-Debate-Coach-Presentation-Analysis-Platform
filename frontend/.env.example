# ---------------------------------------------------------------------------
# LOGOS.AI - frontend environment
#
# Copy this file to .env.local and adjust if your API does not run on :8000.
# Only variables prefixed with NEXT_PUBLIC_ are readable in the browser, and
# ANY value placed here is shipped to the client - never put a secret, API key,
# or database URL in this file. The Groq/Gemini keys belong in ai-ml/.env and
# backend/.env, which are server-side only.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend. No trailing slash. The client appends /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8000

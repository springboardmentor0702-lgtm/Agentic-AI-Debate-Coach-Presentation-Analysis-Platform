# AI/ML Standalone Service Configuration Template
# ===============================================

# AI_ML_MODE: "local" (default offline) | "auto" (provider with fallback) | "provider" (strict API mode)
AI_ML_MODE=local

# Optional: Groq API (free tier at console.groq.com)
# GROQ_API_KEY=gsk_your_groq_api_key
# GROQ_MODEL=llama-3.1-8b-instant

# Optional: Gemini API fallback (free tier at aistudio.google.com)
# GEMINI_API_KEY=your_gemini_api_key
# LLM_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# LOGOS.AI - ai-ml package environment
# Copy this file to .env in the same directory and fill in your own keys.
#   Windows : copy .env.example .env
#   macOS/Linux : cp .env.example .env
# .env is git-ignored. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Primary LLM provider: Groq (fast, generous free tier) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Fallback LLM provider: Google Gemini ---
# Used automatically if Groq errors out or hits its quota.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Speech-to-text (app/agents/speech_analysis.py, faster-whisper)
# ---------------------------------------------------------------------------

# Model size: tiny | base | small | medium | large-v3
# "base" is the recommended laptop default (~150 MB, CPU-friendly, good accuracy).
# Larger models are more accurate but noticeably slower on CPU.
WHISPER_MODEL_SIZE=base

# cpu | cuda   (use cuda only if you have an NVIDIA GPU with CUDA installed)
WHISPER_DEVICE=cpu

# int8 | int8_float16 | float16 | float32
# int8 is the right choice for CPU. Use float16 with cuda.
WHISPER_COMPUTE_TYPE=int8

# =========================================================================
# LOGOS.AI - Configuration Settings
# =========================================================================

# General
PROJECT_NAME="LOGOS.AI - Agentic Debate Coach & Presentation Analysis Platform"
SECRET_KEY="replace-with-a-long-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Primary Relational DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=logos_ai_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logos_ai_db

# MongoDB Secondary Document Store DB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=logos_ai_transcripts
CORS_ORIGINS=http://localhost:3000

# Optional hosted model providers (local deterministic agents work without these)
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=
LLM_MODEL=

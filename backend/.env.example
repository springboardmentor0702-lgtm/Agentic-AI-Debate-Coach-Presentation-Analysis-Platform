# ========================================
# LOGOS.AI Backend Configuration Template
# ========================================

# App
ENVIRONMENT=development
SECRET_KEY=local-dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database - SQLite (default for local dev) or PostgreSQL for production
DATABASE_URL=sqlite:///./logos_ai.db
SQLITE_FALLBACK_URL=sqlite:///./logos_ai.db

# AI Provider - "heuristic" (default, 100% offline, NO keys required)
AI_PROVIDER=heuristic
AI_MODEL=gpt-4o-mini

# Optional: OpenAI-compatible LLM provider
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_API_BASE=https://api.openai.com/v1

# Optional: Audio transcription
TRANSCRIPTION_PROVIDER=disabled
TRANSCRIPTION_MODEL=whisper-1

# CORS
CORS_ORIGINS=http://localhost:3000

# File Uploads
UPLOAD_DIR=./uploads
MAX_AUDIO_FILE_MB=25

# MongoDB (Optional)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=logos_ai_transcripts

# Security & Rate Limiting
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ALLOW_SELF_ASSIGN_ROLES=false

# SpeakAZ Backend Environment Variables
# Copy this to backend/.env

# Required: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq (used as primary for argument analysis agents)
# GROQ_API_KEY=your_groq_api_key_here

# Optional: Override database (defaults to SQLite - no setup needed)
# DATABASE_URL=sqlite:///./speakaz.db

# Optional: MySQL
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=speakaz

# Optional
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SECRET_KEY=change-me-in-production

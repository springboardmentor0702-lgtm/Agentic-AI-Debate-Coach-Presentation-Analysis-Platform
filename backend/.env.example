# LOGOS.AI Environment Configuration
# Copy this file to .env and configure your keys

# The database connection string (SQLite by default, matches your setup)
DATABASE_URL=sqlite:///./logos_ai.db

# JWT settings
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI/ML Configuration
# The generative models are called dynamically. If both are present, Groq is the primary
# and Gemini is the fallback. If only one is present, it will be used. If neither is
# present, the application gracefully degrades to local deterministic fallback bots.
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Enable/Disable the LLM features globally
USE_LLM_AGENTS=true

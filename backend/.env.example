# LOGOS.AI - Configuration Settings

PROJECT_NAME="LOGOS.AI - Agentic Debate Coach & Presentation Analysis Platform"
APP_VERSION=4.3.0
ENVIRONMENT=development
SECRET_KEY="replace-with-a-long-random-secret"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Relational persistence. PostgreSQL is required when ENVIRONMENT=production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logos_ai_db
SQLITE_FALLBACK_URL=sqlite:///./logos_ai.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=logos_ai_db

# Optional MongoDB document store for future transcript/audit integrations.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=logos_ai_transcripts

# Browser security and request limits.
CORS_ORIGINS=http://localhost:3000
MAX_TEXT_LENGTH=20000
DEFAULT_PAGE_SIZE=25
MAX_AUDIO_FILE_MB=25
UPLOAD_DIR=./uploads
ALLOW_SELF_ASSIGN_ROLES=false

# AI provider. `heuristic` works without credentials; `openai`/`llm` enables
# structured model analysis through an OpenAI-compatible endpoint.
AI_PROVIDER=heuristic
AI_MODEL=gpt-5-mini
OPENAI_API_BASE=
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30
FAISS_INDEX_PATH=./data/argument_memory.index
